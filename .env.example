# Required for the Claude Code plugin and the local CLI runner.
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Linear API token used by the local CLI fallback when the Linear MCP isn't wired.
# In CI the GitHub Action uses the Linear MCP server directly and this isn't needed.
# Get from https://linear.app/settings/api
LINEAR_API_TOKEN=

# GitHub token used by the local CLI runner. In CI the Action gets a token
# from the OgenticAI Reviewer GitHub App; for local CLI use a personal token
# with `repo` + `read:org` scope.
GITHUB_TOKEN=

# Used only inside the GitHub Action — the App ID and base64-encoded PEM of
# the OgenticAI Reviewer GitHub App. See docs/GITHUB_APP_SETUP.md.
OGENTICAI_REVIEWER_APP_ID=
OGENTICAI_REVIEWER_APP_KEY=
