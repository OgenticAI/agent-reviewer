{
  "name": "@ogenticai/agent-reviewer",
  "version": "0.1.0-dev",
  "private": true,
  "description": "OgenticAI Reviewer \u2014 AI engineer that lives in GitHub. Reviews each PR against its linked Linear ticket's UAT checklist, comments per-item like a human reviewer, blocks merge on failure, and files follow-ups.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ogenticai-reviewer": "./dist/cli.js",
    "ogenticai-audit": "./dist/audit-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "review-pr": "tsx src/cli.ts",
    "eval": "tsx scripts/run-eval.ts",
    "eval:gen": "tsx scripts/gen-eval-fixtures.ts",
    "drift": "tsx scripts/check-drift.ts",
    "audit": "tsx src/audit-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.1",
    "@octokit/auth-app": "^7.1.4",
    "@octokit/rest": "^21.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
